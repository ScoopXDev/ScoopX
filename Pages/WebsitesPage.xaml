<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScoopX.Pages.WebsitesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScoopX.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Background="Transparent">
        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Background="Transparent">
            <Grid Padding="20,16,24,24" RowSpacing="16" VerticalAlignment="Top" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="AddSiteButton" x:Uid="SitesAdd" Style="{StaticResource AccentButtonStyle}" Click="AddSiteButton_Click" />

                    <DropDownButton x:Uid="SitesAdvanced">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Uid="SitesDefaultPage" />
                                <MenuFlyoutItem x:Uid="SitesPhpCli" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <ComboBox
                        x:Name="CategoryFilterComboBox"
                        MinWidth="120"
                        SelectedIndex="0"
                        SelectionChanged="CategoryFilterComboBox_SelectionChanged">
                        <ComboBoxItem x:Uid="SitesFilterAll" Tag="all" />
                        <ComboBoxItem x:Uid="SitesFilterRunning" Tag="running" />
                        <ComboBoxItem x:Uid="SitesFilterStopped" Tag="stopped" />
                    </ComboBox>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        x:Uid="SitesSearch"
                        Width="220"
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged"
                        QuerySubmitted="SearchBox_QuerySubmitted" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                VerticalAlignment="Top"
                Style="{StaticResource ScoopGlassCardStyle}"
                CornerRadius="14"
                Background="{ThemeResource ScoopGlassStrongAcrylicBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Padding="16,12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            x:Name="HeaderSelectAllCheckBox"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Click="SelectAllCheckBox_Click" />
                        <TextBlock Grid.Column="1" x:Uid="SitesColName" FontWeight="SemiBold" Foreground="{ThemeResource ScoopTextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Uid="SitesColStatus" FontWeight="SemiBold" Foreground="{ThemeResource ScoopTextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" x:Uid="SitesColRoot" FontWeight="SemiBold" Foreground="{ThemeResource ScoopTextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" x:Uid="SitesColRemark" FontWeight="SemiBold" Foreground="{ThemeResource ScoopTextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" x:Uid="SitesColPhp" FontWeight="SemiBold" Foreground="{ThemeResource ScoopTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="6" x:Uid="SitesColActions" FontWeight="SemiBold" Foreground="{ThemeResource ScoopTextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl
                        x:Name="WebsiteList"
                        Grid.Row="1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:WebsiteItem">
                                <Grid
                                    Padding="16,10"
                                    MinHeight="48"
                                    ColumnSpacing="12"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                        Checked="ItemCheckBox_Changed"
                                        Unchecked="ItemCheckBox_Changed" />
                                    <HyperlinkButton
                                        Grid.Column="1"
                                        x:Uid="SitesEditTooltip"
                                        Style="{StaticResource TableLinkButtonStyle}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Tag="{x:Bind}"
                                        Click="SiteName_Click">
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        x:Uid="SitesToggleTooltip"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        OnContent=""
                                        OffContent=""
                                        IsOn="{x:Bind IsRunning, Mode=TwoWay}"
                                        Tag="{x:Bind}"
                                        Toggled="StatusToggle_Toggled" />
                                    <HyperlinkButton
                                        Grid.Column="3"
                                        Style="{StaticResource TableLinkButtonStyle}"
                                        Foreground="{ThemeResource ScoopTextSecondaryBrush}"
                                        Tag="{x:Bind RootPath}"
                                        Click="RootPath_Click"
                                        ToolTipService.ToolTip="{x:Bind RootPath}">
                                        <TextBlock
                                            Text="{x:Bind RootPath}"
                                            Foreground="{ThemeResource ScoopTextSecondaryBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>
                                    <TextBlock Grid.Column="4" Text="{x:Bind Remark}" Foreground="{ThemeResource ScoopTextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind PhpVersion}" Foreground="{ThemeResource ScoopTextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <HyperlinkButton
                                            x:Uid="SitesActionSettings"
                                            Style="{StaticResource TableLinkButtonStyle}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Tag="{x:Bind}"
                                            Click="SiteName_Click" />
                                        <Border
                                            Width="1"
                                            Height="12"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <HyperlinkButton
                                            x:Uid="SitesActionDelete"
                                            Style="{StaticResource TableLinkButtonStyle}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid
                        Grid.Row="2"
                        Padding="16,12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <CheckBox
                                x:Name="SelectAllCheckBox"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                Click="SelectAllCheckBox_Click" />
                            <ComboBox
                                x:Name="BatchActionComboBox"
                                x:Uid="SitesBatchPlaceholder"
                                Width="180"
                                VerticalAlignment="Center"
                                SelectionChanged="BatchActionComboBox_SelectionChanged" />
                            <Button
                                x:Name="BatchActionButton"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="False"
                                Click="BatchActionButton_Click" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="PrevPageButton"
                                x:Uid="SitesPrevPage"
                                MinWidth="32"
                                Padding="8,4"
                                Click="PrevPageButton_Click">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                            <StackPanel x:Name="PageNumbersPanel" Orientation="Horizontal" Spacing="4" />
                            <Button
                                x:Name="NextPageButton"
                                x:Uid="SitesNextPage"
                                MinWidth="32"
                                Padding="8,4"
                                Click="NextPageButton_Click">
                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                            </Button>
                            <ComboBox
                                x:Name="PageSizeComboBox"
                                MinWidth="100"
                                VerticalAlignment="Center"
                                SelectionChanged="PageSizeComboBox_SelectionChanged" />
                            <TextBlock
                                x:Name="TotalCountText"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock x:Uid="SitesGoto" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBox
                                x:Name="JumpPageTextBox"
                                Width="48"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                KeyDown="JumpPageTextBox_KeyDown" />
                            <TextBlock x:Uid="SitesPageUnit" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <InfoBar
            x:Name="StatusFeedbackBar"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,12,24,0"
            MaxWidth="360"
            IsOpen="False"
            IsClosable="True"
            Severity="Success" />
    </Grid>
</Page>
