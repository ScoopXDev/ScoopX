<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ScoopX.Pages.AddSiteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="AddSiteDialog"
    DefaultButton="Secondary"
    CornerRadius="12"
    PrimaryButtonStyle="{StaticResource SoftCancelButtonStyle}"
    SecondaryButtonStyle="{StaticResource SoftConfirmButtonStyle}"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <TextBlock
                Text="{Binding}"
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="{ThemeResource ScoopTextPrimaryBrush}" />
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">28,22,28,20</Thickness>
        <Thickness x:Key="ContentDialogTitleMargin">0,0,0,16</Thickness>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
        <Thickness x:Key="ContentDialogCommandSpaceMargin">0,20,0,0</Thickness>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">520</x:Double>
        <Thickness x:Key="ContentDialogBorderThickness">0</Thickness>
        <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#99000000" />
    </ContentDialog.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Hidden"
        HorizontalScrollBarVisibility="Disabled"
        MaxHeight="520">
        <StackPanel Spacing="18">
            <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock x:Uid="AddSiteDomain" Style="{StaticResource DialogFieldLabelStyle}" />
                    <TextBlock x:Uid="AddSiteDomainHint" Style="{StaticResource DialogFieldHintStyle}" />
                </StackPanel>
                <TextBox
                    x:Name="DomainsTextBox"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="104"
                    PlaceholderText="example.com&#x0a;blog.local"
                    CornerRadius="6" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="AddSiteRemark" Style="{StaticResource DialogFieldLabelStyle}" />
                <TextBox
                    x:Name="RemarkTextBox"
                    x:Uid="AddSiteRemarkPlaceholder"
                    CornerRadius="6" />
            </StackPanel>

            <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock x:Uid="AddSiteRoot" Style="{StaticResource DialogFieldLabelStyle}" />
                    <TextBlock x:Uid="AddSiteRootHint" Style="{StaticResource DialogFieldHintStyle}" />
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="RootPathTextBox"
                        x:Uid="AddSiteRootPlaceholder"
                        Text="C:\ScoopX\wwwroot"
                        CornerRadius="6" />
                    <Button
                        Grid.Column="1"
                        x:Uid="AddSiteBrowse"
                        MinWidth="72"
                        CornerRadius="6"
                        VerticalAlignment="Stretch"
                        Click="BrowseRootButton_Click" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock x:Uid="AddSiteDatabase" Style="{StaticResource DialogFieldLabelStyle}" />
                    <TextBlock x:Uid="AddSiteDatabaseHint" Style="{StaticResource DialogFieldHintStyle}" />
                </StackPanel>
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton
                                x:Name="DbNoneRadio"
                                x:Uid="AddSiteDbNone"
                                GroupName="Database"
                                IsChecked="True"
                                Checked="DatabaseOption_Changed" />
                            <RadioButton
                                x:Name="DbMysqlRadio"
                                Content="MySQL"
                                GroupName="Database"
                                Checked="DatabaseOption_Changed" />
                        </StackPanel>

                        <Grid
                            x:Name="MysqlCredentialsPanel"
                            ColumnSpacing="12"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="AddSiteDbUser" Style="{StaticResource DialogFieldHintStyle}" />
                                <TextBox
                                    x:Name="DbUserTextBox"
                                    x:Uid="AddSiteDbUserPlaceholder"
                                    CornerRadius="6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="AddSiteDbPassword" Style="{StaticResource DialogFieldHintStyle}" />
                                <PasswordBox
                                    x:Name="DbPasswordBox"
                                    x:Uid="AddSiteDbPasswordPlaceholder"
                                    CornerRadius="6" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock x:Uid="AddSitePhp" Style="{StaticResource DialogFieldLabelStyle}" />
                    <TextBlock x:Uid="AddSitePhpHint" Style="{StaticResource DialogFieldHintStyle}" />
                </StackPanel>
                <ComboBox
                    x:Name="PhpVersionComboBox"
                    HorizontalAlignment="Stretch"
                    CornerRadius="6"
                    SelectedIndex="3">
                    <ComboBoxItem Content="7.4" />
                    <ComboBoxItem Content="8.0" />
                    <ComboBoxItem Content="8.1" />
                    <ComboBoxItem Content="8.2" />
                    <ComboBoxItem Content="8.3" />
                </ComboBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
