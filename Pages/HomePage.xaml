<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScoopX.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScoopX.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Background="Transparent">
        <StackPanel Padding="20,16,24,24" Spacing="8">
            <!-- 状态 -->
            <TextBlock
                Text="状态"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:StatusGauge x:Name="LoadGauge" Grid.Column="0" HorizontalAlignment="Center" />
                <controls:StatusGauge x:Name="CpuGauge" Grid.Column="1" HorizontalAlignment="Center" />
                <controls:StatusGauge x:Name="MemoryGauge" Grid.Column="2" HorizontalAlignment="Center" />
                <controls:StatusGauge x:Name="DiskGauge" Grid.Column="3" HorizontalAlignment="Center" />
            </Grid>

            <!-- 磁盘 IO 监控 -->
            <Border
                Margin="0,16,0,0"
                Background="#F7F7F7"
                CornerRadius="12"
                Padding="16,14">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>

                    <!-- 顶栏：磁盘IO + 磁盘筛选 -->
                    <Grid>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="磁盘IO" FontSize="14" FontWeight="SemiBold" Foreground="#111827" />
                            <Border Width="42" Height="2" CornerRadius="1" HorizontalAlignment="Left" Background="{StaticResource ScoopAccentBrush}" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <TextBlock Text="磁盘" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" />
                            <ComboBox
                                x:Name="DiskFilterComboBox"
                                MinWidth="88"
                                CornerRadius="6"
                                SelectedIndex="0" />
                        </StackPanel>
                    </Grid>

                    <!-- 指标卡 -->
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#F472B6" VerticalAlignment="Center" />
                                <TextBlock FontSize="13" Foreground="#374151" VerticalAlignment="Center">
                                    <Run Text="读取 " />
                                    <Run x:Name="DiskReadText" Text="0 B" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#60A5FA" VerticalAlignment="Center" />
                                <TextBlock FontSize="13" Foreground="#374151" VerticalAlignment="Center">
                                    <Run Text="写入 " />
                                    <Run x:Name="DiskWriteText" Text="0 B" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="8" Padding="12,10">
                            <TextBlock FontSize="13" Foreground="#374151" VerticalAlignment="Center">
                                <Run Text="每秒读写 " />
                                <Run x:Name="DiskOpsText" Text="0" FontWeight="SemiBold" />
                                <Run Text=" 次" />
                            </TextBlock>
                        </Border>

                        <Border Grid.Column="3" Background="#FFFFFF" CornerRadius="8" Padding="12,10">
                            <TextBlock FontSize="13" Foreground="#374151" VerticalAlignment="Center">
                                <Run Text="IO延迟 " />
                                <Run x:Name="DiskLatencyText" Text="0 ms" FontWeight="SemiBold" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- 图表 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>

                        <Canvas x:Name="ChartYLabels" Grid.Row="0" />

                        <Border
                            Grid.Column="1"
                            Grid.Row="0"
                            Background="#FFFFFF"
                            CornerRadius="8"
                            Padding="4">
                            <Canvas
                                x:Name="ChartCanvas"
                                SizeChanged="ChartCanvas_SizeChanged" />
                        </Border>

                        <StackPanel
                            x:Name="ChartXLabels"
                            Grid.Column="1"
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="4,4,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
