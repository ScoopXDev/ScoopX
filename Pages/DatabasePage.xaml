<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScoopX.Pages.DatabasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ScoopX.Controls"
    xmlns:local="using:ScoopX.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="DatabaseTabButtonStyle" TargetType="controls:HandCursorButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,12,4,14" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:HandCursorButton">
                        <ContentPresenter
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DatabaseToolbarButtonStyle" TargetType="controls:HandCursorButton">
            <Setter Property="Background" Value="{ThemeResource SoftInputFillBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource ScoopTextBodyBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:HandCursorButton">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DatabaseServiceChipStyle" TargetType="controls:HandCursorButton">
            <Setter Property="Background" Value="{ThemeResource SoftInputFillBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource ScoopTextBodyBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:HandCursorButton">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DatabaseHoverMenuItemStyle" TargetType="controls:HandCursorButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource ScoopTextBodyBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:HandCursorButton">
                        <Border
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tabs + 可滑动指示条 -->
        <Grid Padding="24,10,24,0" HorizontalAlignment="Left">
            <Grid
                x:Name="TabBarHost"
                HorizontalAlignment="Left"
                Loaded="TabBarHost_Loaded"
                SizeChanged="TabBarHost_SizeChanged">
                <StackPanel
                    x:Name="TabButtonsPanel"
                    Orientation="Horizontal"
                    Spacing="28"
                    HorizontalAlignment="Left">
                    <controls:HandCursorButton
                        x:Name="MySqlTabButton"
                        Tag="MySQL"
                        Style="{StaticResource DatabaseTabButtonStyle}"
                        Click="DatabaseTab_Click">
                        <TextBlock
                            x:Name="MySqlTabText"
                            Text="MySQL"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ScoopAccentBrush}" />
                    </controls:HandCursorButton>

                    <controls:HandCursorButton
                        x:Name="SqlServerTabButton"
                        Tag="SQLServer"
                        Style="{StaticResource DatabaseTabButtonStyle}"
                        Click="DatabaseTab_Click">
                        <TextBlock
                            x:Name="SqlServerTabText"
                            Text="SQLServer"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ScoopTextSecondaryBrush}" />
                    </controls:HandCursorButton>

                    <controls:HandCursorButton
                        x:Name="RedisTabButton"
                        Tag="Redis"
                        Style="{StaticResource DatabaseTabButtonStyle}"
                        Click="DatabaseTab_Click">
                        <TextBlock
                            x:Name="RedisTabText"
                            Text="Redis"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ScoopTextSecondaryBrush}" />
                    </controls:HandCursorButton>

                    <controls:HandCursorButton
                        x:Name="MongoDbTabButton"
                        Tag="MongoDB"
                        Style="{StaticResource DatabaseTabButtonStyle}"
                        Click="DatabaseTab_Click">
                        <TextBlock
                            x:Name="MongoDbTabText"
                            Text="MongoDB"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ScoopTextSecondaryBrush}" />
                    </controls:HandCursorButton>

                    <controls:HandCursorButton
                        x:Name="PgSqlTabButton"
                        Tag="PgSQL"
                        Style="{StaticResource DatabaseTabButtonStyle}"
                        Click="DatabaseTab_Click">
                        <TextBlock
                            x:Name="PgSqlTabText"
                            Text="PgSQL"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ScoopTextSecondaryBrush}" />
                    </controls:HandCursorButton>
                </StackPanel>

                <Border
                    x:Name="TabIndicator"
                    Width="36"
                    Height="3"
                    CornerRadius="1.5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource ScoopAccentBrush}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TabIndicatorTransform" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>

        <!-- 各 Tab 内容区 -->
        <Grid Grid.Row="1" Padding="24,12,24,24">
            <Grid x:Name="MySqlPanel" Visibility="Visible" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                    <controls:HandCursorButton
                        x:Name="MySqlAddDatabaseButton"
                        x:Uid="DbMySqlAddDatabase"
                        Style="{StaticResource SoftAccentButtonStyle}"
                        Click="MySqlAddDatabaseButton_Click" />
                    <controls:HandCursorButton
                        x:Name="MySqlRootPasswordButton"
                        x:Uid="DbMySqlRootPassword"
                        Style="{StaticResource DatabaseToolbarButtonStyle}"
                        Click="MySqlRootPasswordButton_Click" />
                    <controls:HandCursorButton
                        x:Name="MySqlPhpMyAdminButton"
                        x:Uid="DbMySqlPhpMyAdmin"
                        Style="{StaticResource DatabaseToolbarButtonStyle}" />

                    <!-- MySQL 版本芯片：菜单用 RenderTransform 上浮，不占布局高度 -->
                    <Grid
                        x:Name="MySqlServiceChipHost"
                        VerticalAlignment="Top"
                        PointerEntered="MySqlServiceChipHost_PointerEntered"
                        PointerExited="MySqlServiceChipHost_PointerExited">
                        <controls:HandCursorButton
                            x:Name="MySqlServiceChipButton"
                            Style="{StaticResource DatabaseServiceChipStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <Path
                                        Fill="#008CDB"
                                        Data="M913.65 760.684c0.198-1.8 0.198-3.598 0.398-5.196-9.994-11.596-18.59-24.59-29.984-34.784-48.176-42.78-99.75-80.16-160.922-102.55-14.792-5.396-24.186-14.592-30.584-28.186-16.792-35.584-34.182-70.966-50.774-106.748-13.794-29.586-24.388-60.97-40.582-89.156-41.98-73.764-99.15-134.134-168.716-183.31-49.576-34.982-101.552-61.97-164.32-62.368-9.396 0-19.792-6.198-27.986-12.196-34.384-23.988-69.766-44.776-113.344-44.176-25.788 0.4-45.376 19.59-43.778 45.376 0.798 13.792 5.598 28.586 12.594 40.378 11.794 19.792 27.586 36.982 40.58 56.174 7.996 11.792 14.992 24.588 19.99 37.982 9.996 25.388 16.392 52.374 27.786 77.162 10.594 22.79 25.988 43.378 38.382 65.368 2.798 4.998 4.198 12.594 2.398 17.992-17.39 57.172-29.186 114.744-15.392 174.514 7.396 32.384 18.59 62.968 44.378 85.56 23.988 20.788 51.776 11.194 58.772-19.792 1.198-5.596 1.798-11.394 2.798-16.992 2.398-13.794 4.998-27.586 7.596-42.38 16.592 26.188 29.786 51.974 47.776 73.964 18.192 22.19 41.18 40.38 62.17 60.172 1-1 1.798-2 2.798-2.8-47.176-60.97-85.158-127.136-111.346-199.5-41.78 33.382-38.582 82.36-46.376 127.536-16.392-3.398-23.388-14.192-28.786-26.186-26.788-59.372-28.188-119.742-8.198-181.31 3.998-12.394 9.596-24.59 10.996-37.184 1-8.396-1.4-20.39-6.998-25.986-24.586-24.788-38.58-55.172-47.576-87.756-13.792-49.976-35.782-95.154-69.964-134.334-6.198-7.198-12.394-15.392-14.994-24.388-2.598-8.796-3.998-20.792-0.2-28.186 4.998-9.598 17.192-8.396 27.386-4.798 30.584 10.594 59.97 23.188 85.358 43.78 7.198 5.796 17.592 9.594 26.988 10.792 28.586 3.598 57.772 2.4 84.56 15.992 16.19 8.396 32.982 15.792 48.576 25.19 94.554 57.97 164.918 136.732 207.898 240.082 21.39 51.376 46.578 101.152 70.564 151.524 7.596 15.992 18.792 29.386 37.382 33.586 60.97 13.392 109.946 49.576 159.522 84.358 5.796 3.998 10.594 9.794 17.99 16.99-7.396 0.602-10.194 1.202-12.994 1.202-38.78-0.6-76.362 5.796-112.944 19.39-11.792 4.396-16.192 9.196-8.794 20.59 4.598 7.196 8.196 15.392 13.392 21.99 21.59 27.586 50.776 44.978 80.76 61.57 28.186 15.392 55.574 32.384 82.96 48.976 6.196 3.598 11.194 8.996 16.792 13.392 1.2-1.2 2.398-2.398 3.398-3.598-8.996-10.196-18.39-19.792-26.786-30.384-24.988-31.384-54.972-56.374-90.156-75.562-8.794-4.798-16.992-10.996-24.588-17.594-4.998-4.396-8.396-10.594-14.392-18.19 45.374-9.4 86.954-17.596 128.536-25.992zM287.956 288.316c12.794-13.194 13.994-25.588 4.398-38.782-9.994-13.794-20.79-16.392-34.982-8.796a14563.088 14563.088 0 0 0 30.584 47.578z" />
                                </Viewbox>
                                <TextBlock
                                    x:Name="MySqlServiceVersionText"
                                    Text="MySQL 5.7.44"
                                    FontSize="13"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource ScoopTextBodyBrush}" />
                                <Path
                                    Width="8"
                                    Height="9"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center"
                                    Fill="#22C55E"
                                    Data="M0,0 L8,4.5 L0,9 Z" />
                            </StackPanel>
                        </controls:HandCursorButton>

                        <StackPanel
                            x:Name="MySqlServiceHoverMenu"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Opacity="0"
                            IsHitTestVisible="False"
                            PointerEntered="MySqlServiceHoverMenu_PointerEntered"
                            PointerExited="MySqlServiceHoverMenu_PointerExited">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="-52" />
                            </StackPanel.RenderTransform>
                            <Border
                                Background="{ThemeResource ScoopCardFillBrush}"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="6,2"
                                Translation="0,0,32">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:HandCursorButton
                                        x:Uid="DbMySqlStop"
                                        Style="{StaticResource DatabaseHoverMenuItemStyle}"
                                        Click="MySqlServiceAction_Click"
                                        Tag="Stop" />
                                    <Border
                                        Width="1"
                                        Height="14"
                                        Margin="2,0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource ScoopTextTertiaryBrush}"
                                        Opacity="0.55" />
                                    <controls:HandCursorButton
                                        x:Uid="DbMySqlRestart"
                                        Style="{StaticResource DatabaseHoverMenuItemStyle}"
                                        Click="MySqlServiceAction_Click"
                                        Tag="Restart" />
                                    <Border
                                        Width="1"
                                        Height="14"
                                        Margin="2,0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource ScoopTextTertiaryBrush}"
                                        Opacity="0.55" />
                                    <controls:HandCursorButton
                                        x:Uid="DbMySqlReload"
                                        Style="{StaticResource DatabaseHoverMenuItemStyle}"
                                        Click="MySqlServiceAction_Click"
                                        Tag="Reload" />
                                </StackPanel>
                            </Border>
                            <Path
                                Width="12"
                                Height="7"
                                Margin="0,-1,0,0"
                                HorizontalAlignment="Center"
                                Stretch="Fill"
                                Fill="{ThemeResource ScoopCardFillBrush}"
                                Data="M0,0 L6,7 L12,0 Z" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Style="{StaticResource ScoopGlassCardStyle}"
                    CornerRadius="14"
                    Background="{ThemeResource ScoopGlassStrongAcrylicBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Padding="16,12"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="DbColName" FontWeight="SemiBold" Foreground="{ThemeResource ScoopTextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Uid="DbColUsername" FontWeight="SemiBold" Foreground="{ThemeResource ScoopTextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Uid="DbColPassword" FontWeight="SemiBold" Foreground="{ThemeResource ScoopTextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" x:Uid="DbColRemark" FontWeight="SemiBold" Foreground="{ThemeResource ScoopTextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" x:Uid="DbColActions" FontWeight="SemiBold" Foreground="{ThemeResource ScoopTextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <Grid MinHeight="48">
                            <ItemsControl x:Name="MySqlDatabaseList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DatabaseItem">
                                        <Grid
                                            Padding="16,10"
                                            MinHeight="48"
                                            ColumnSpacing="12"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.4*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                Foreground="{ThemeResource ScoopTextPrimaryBrush}"
                                                VerticalAlignment="Center"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Username}"
                                                Foreground="{ThemeResource ScoopTextPrimaryBrush}"
                                                VerticalAlignment="Center"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind Password}"
                                                Foreground="{ThemeResource ScoopTextPrimaryBrush}"
                                                VerticalAlignment="Center"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{x:Bind Remark}"
                                                Foreground="{ThemeResource ScoopTextPrimaryBrush}"
                                                VerticalAlignment="Center"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel
                                                Grid.Column="4"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                                <HyperlinkButton
                                                    x:Uid="DbActionManage"
                                                    Style="{StaticResource TableLinkButtonStyle}"
                                                    Foreground="{StaticResource ScoopAccentBrush}"
                                                    Tag="{x:Bind}"
                                                    Click="DatabaseManage_Click" />
                                                <Border
                                                    Width="1"
                                                    Height="12"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                <HyperlinkButton
                                                    x:Uid="DbActionChangePassword"
                                                    Style="{StaticResource TableLinkButtonStyle}"
                                                    Foreground="{StaticResource ScoopAccentBrush}"
                                                    Tag="{x:Bind}"
                                                    Click="DatabaseChangePassword_Click" />
                                                <Border
                                                    Width="1"
                                                    Height="12"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                <HyperlinkButton
                                                    x:Uid="DbActionDelete"
                                                    Style="{StaticResource TableLinkButtonStyle}"
                                                    Foreground="{StaticResource ScoopAccentBrush}"
                                                    Tag="{x:Bind}"
                                                    Click="DatabaseDelete_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                x:Name="MySqlEmptyHint"
                                x:Uid="DbListEmpty"
                                Margin="16,28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource ScoopTextTertiaryBrush}" />
                            </Grid>
                        </ScrollViewer>

                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            Padding="16,12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <Button
                                x:Name="MySqlPrevPageButton"
                                x:Uid="SitesPrevPage"
                                MinWidth="32"
                                Padding="8,4"
                                Click="MySqlPrevPageButton_Click">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                            <StackPanel x:Name="MySqlPageNumbersPanel" Orientation="Horizontal" Spacing="4" />
                            <Button
                                x:Name="MySqlNextPageButton"
                                x:Uid="SitesNextPage"
                                MinWidth="32"
                                Padding="8,4"
                                Click="MySqlNextPageButton_Click">
                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                            </Button>
                            <ComboBox
                                x:Name="MySqlPageSizeComboBox"
                                MinWidth="100"
                                VerticalAlignment="Center"
                                SelectionChanged="MySqlPageSizeComboBox_SelectionChanged" />
                            <TextBlock
                                x:Name="MySqlTotalCountText"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock x:Uid="SitesGoto" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBox
                                x:Name="MySqlJumpPageTextBox"
                                Width="48"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                KeyDown="MySqlJumpPageTextBox_KeyDown" />
                            <TextBlock x:Uid="SitesPageUnit" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SqlServerPanel" Visibility="Collapsed" />
            <Grid x:Name="RedisPanel" Visibility="Collapsed" />
            <Grid x:Name="MongoDbPanel" Visibility="Collapsed" />
            <Grid x:Name="PgSqlPanel" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
