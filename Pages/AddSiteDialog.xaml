<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ScoopX.Pages.AddSiteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="添加站点"
    PrimaryButtonText="取消"
    SecondaryButtonText="确定"
    DefaultButton="Secondary"
    CornerRadius="12"
    PrimaryButtonStyle="{StaticResource SoftCancelButtonStyle}"
    SecondaryButtonStyle="{StaticResource SoftConfirmButtonStyle}"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <TextBlock
                Text="{Binding}"
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="#111827" />
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">28,22,28,20</Thickness>
        <Thickness x:Key="ContentDialogTitleMargin">0,0,0,16</Thickness>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
        <Thickness x:Key="ContentDialogCommandSpaceMargin">0,20,0,0</Thickness>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">520</x:Double>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#0F000000" />
        <Thickness x:Key="ContentDialogBorderThickness">0</Thickness>
        <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#99000000" />
    </ContentDialog.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Hidden"
        HorizontalScrollBarVisibility="Disabled"
        MaxHeight="520">
        <StackPanel Spacing="18">
            <!-- 域名 -->
            <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="域名" Style="{StaticResource DialogFieldLabelStyle}" />
                    <TextBlock
                        Text="每行一个域名，可一次添加多个站点"
                        Style="{StaticResource DialogFieldHintStyle}" />
                </StackPanel>
                <TextBox
                    x:Name="DomainsTextBox"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="104"
                    PlaceholderText="example.com&#x0a;blog.local"
                    CornerRadius="6" />
            </StackPanel>

            <!-- 备注 -->
            <StackPanel Spacing="8">
                <TextBlock Text="备注" Style="{StaticResource DialogFieldLabelStyle}" />
                <TextBox
                    x:Name="RemarkTextBox"
                    PlaceholderText="可选"
                    CornerRadius="6" />
            </StackPanel>

            <!-- 根目录 -->
            <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="根目录" Style="{StaticResource DialogFieldLabelStyle}" />
                    <TextBlock
                        Text="站点文件将保存在此目录下"
                        Style="{StaticResource DialogFieldHintStyle}" />
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="RootPathTextBox"
                        Text="C:\ScoopX\wwwroot"
                        PlaceholderText="选择网站根目录"
                        CornerRadius="6" />
                    <Button
                        Grid.Column="1"
                        Content="浏览"
                        MinWidth="72"
                        CornerRadius="6"
                        VerticalAlignment="Stretch"
                        Click="BrowseRootButton_Click" />
                </Grid>
            </StackPanel>

            <!-- 数据库 -->
            <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="数据库" Style="{StaticResource DialogFieldLabelStyle}" />
                    <TextBlock
                        Text="可为站点同时创建数据库账号"
                        Style="{StaticResource DialogFieldHintStyle}" />
                </StackPanel>
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton
                                x:Name="DbNoneRadio"
                                Content="不创建"
                                GroupName="Database"
                                IsChecked="True"
                                Checked="DatabaseOption_Changed" />
                            <RadioButton
                                x:Name="DbMysqlRadio"
                                Content="MySQL"
                                GroupName="Database"
                                Checked="DatabaseOption_Changed" />
                        </StackPanel>

                        <Grid
                            x:Name="MysqlCredentialsPanel"
                            ColumnSpacing="12"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="数据库账号" Style="{StaticResource DialogFieldHintStyle}" />
                                <TextBox
                                    x:Name="DbUserTextBox"
                                    PlaceholderText="账号"
                                    CornerRadius="6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="数据库密码" Style="{StaticResource DialogFieldHintStyle}" />
                                <PasswordBox
                                    x:Name="DbPasswordBox"
                                    PlaceholderText="密码"
                                    CornerRadius="6" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- PHP 版本 -->
            <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="PHP 版本" Style="{StaticResource DialogFieldLabelStyle}" />
                    <TextBlock
                        Text="站点运行时使用的 PHP 版本"
                        Style="{StaticResource DialogFieldHintStyle}" />
                </StackPanel>
                <ComboBox
                    x:Name="PhpVersionComboBox"
                    HorizontalAlignment="Stretch"
                    CornerRadius="6"
                    SelectedIndex="3">
                    <ComboBoxItem Content="7.4" />
                    <ComboBoxItem Content="8.0" />
                    <ComboBoxItem Content="8.1" />
                    <ComboBoxItem Content="8.2" />
                    <ComboBoxItem Content="8.3" />
                </ComboBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
